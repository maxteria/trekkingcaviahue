{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trekkingcaviahue",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
