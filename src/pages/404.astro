---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ROUTES } from '../data/site';
---

<BaseLayout
  locale="es"
  title="Página no encontrada · Trekking Caviahue"
  description="La página que buscás no existe."
  path="/404/"
  alternatePath="/404/"
>
  <section class="container-page flex min-h-[60vh] flex-col items-start justify-center py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">404</p>
    <h1 class="mt-3 max-w-2xl font-display text-4xl tracking-tight text-ink-900 sm:text-5xl">
      Esta huella no lleva a ningún lado
    </h1>
    <p class="mt-4 max-w-xl text-ink-500">
      La página que buscás no existe o cambió de lugar. Volvé al inicio o mirá el catálogo completo de excursiones.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={ROUTES.home.es}
        class="inline-flex items-center gap-2 rounded-full bg-brand-500 px-6 py-3.5 text-sm font-semibold text-white shadow-soft transition hover:bg-brand-600"
      >
        Ir al inicio
      </a>
      <a
        href={ROUTES.excursions.es}
        class="inline-flex items-center gap-2 rounded-full border border-ink-900/15 bg-white px-6 py-3.5 text-sm font-semibold text-ink-900 transition hover:border-brand-400 hover:text-brand-700"
      >
        Ver excursiones
      </a>
    </div>
    <a href={ROUTES.home.en} class="mt-6 text-sm text-ink-500 underline-offset-4 hover:underline">
      Go to the English site →
    </a>
  </section>
</BaseLayout>
