---
import { ROUTES, SITE, whatsappLink } from '../data/site';
import { t, type Locale } from '../data/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const year = new Date().getFullYear();

const waHref = whatsappLink(
  locale === 'es' ? 'Hola Josefina! Quiero consultar por una excursión.' : 'Hi Josefina! I would like to ask about an excursion.',
);
---

<footer class="mt-24 border-t border-cream-300/70 bg-cream-100">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <p class="font-display text-xl tracking-tight text-ink-900">
        Trekking <span class="text-brand-600">Caviahue</span>
      </p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-500">{ui.footer.tagline}</p>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500">{ui.footer.contact}</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li>
          <a href={waHref} target="_blank" rel="noopener noreferrer" class="text-ink-800 transition-colors hover:text-brand-600">
            {ui.footer.whatsapp} · {SITE.whatsappDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} class="text-ink-800 transition-colors hover:text-brand-600">{SITE.email}</a>
        </li>
        <li class="text-ink-500">{SITE.location.city}, {SITE.location.region}</li>
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500">{ui.footer.follow}</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li>
          <a
            href={SITE.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-800 transition-colors hover:text-brand-600"
          >
            {ui.footer.instagram} · @{SITE.instagram}
          </a>
        </li>
        <li>
          <a href={SITE.agencyUrl} target="_blank" rel="noopener noreferrer" class="text-ink-800 transition-colors hover:text-brand-600">
            caviahue.tur.ar
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500">{ui.nav.excursions}</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li>
          <a href={ROUTES.excursions[locale]} class="text-ink-800 transition-colors hover:text-brand-600">{ui.nav.excursions}</a>
        </li>
        <li>
          <a href={ROUTES.about[locale]} class="text-ink-800 transition-colors hover:text-brand-600">{ui.nav.about}</a>
        </li>
        <li>
          <a href={ROUTES.home[locale]} class="text-ink-800 transition-colors hover:text-brand-600">{ui.nav.home}</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-cream-300/70">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-ink-500 sm:flex-row sm:items-center sm:justify-between">
      <p>{ui.footer.rights(year)}</p>
      <p class="max-w-md sm:text-right">{ui.footer.credit}</p>
    </div>
    <div class="container-page pb-6 text-center text-xs text-ink-500">
      <span>Hecho con amor <svg viewBox="0 0 24 24" fill="currentColor" class="inline-block h-3.5 w-3.5 -mt-0.5 text-brand-500" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg> por Jose &amp; Maxi</span>
    </div>
  </div>
</footer>
