---
import { whatsappLink } from '../data/site';

interface Props {
  message: string;
  label: string;
  variant?: 'primary' | 'outline' | 'light';
  size?: 'md' | 'lg';
  class?: string;
}

const { message, label, variant = 'primary', size = 'md', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2.5 rounded-full font-semibold transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2';
const sizes = { md: 'px-5 py-3 text-sm', lg: 'px-6 py-3.5 text-base' };
const variants = {
  primary: 'bg-brand-500 text-white shadow-soft hover:bg-brand-600 hover:shadow-lift',
  outline: 'border border-ink-900/15 bg-white text-ink-900 hover:border-brand-400 hover:text-brand-700',
  light: 'bg-white text-brand-700 shadow-soft hover:bg-cream-100',
};
---

<a
  href={whatsappLink(message)}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[base, sizes[size], variants[variant], className]}
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-[1.15em] w-[1.15em]">
    <path
      d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.42 1.27 4.86L2 22l5.3-1.32a9.9 9.9 0 0 0 4.74 1.2h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2Zm5.8 14.15c-.24.68-1.4 1.3-1.94 1.35-.5.05-.97.24-3.26-.68-2.76-1.09-4.5-3.9-4.64-4.09-.13-.19-1.1-1.47-1.1-2.8 0-1.33.7-1.98.95-2.25.24-.27.53-.34.7-.34h.5c.16 0 .38-.06.59.45.22.53.74 1.83.8 1.96.07.13.11.29.02.47-.09.19-.13.3-.27.46-.13.16-.28.36-.4.48-.13.13-.27.28-.12.54.16.27.69 1.14 1.48 1.85 1.02.91 1.88 1.19 2.15 1.32.26.13.42.11.57-.07.16-.18.66-.77.84-1.03.18-.27.36-.22.6-.13.25.09 1.55.73 1.82.86.27.13.45.2.51.31.07.11.07.64-.17 1.32Z"
    ></path>
  </svg>
  {label}
</a>
